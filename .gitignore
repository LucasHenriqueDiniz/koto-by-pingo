# Tool caches
.cache/
.local/

# Environment secrets
.env
.env.local
.env.*.local
# wrangler's local secret file. It carries TEST_BYPASS_SECRET during a `wrangler dev`
# session, so it must never be committed — the bypass is only as safe as this line.
.dev.vars

# Cloudflare
# The blanket ignore sits right under "Environment secrets", which is the mistake: a wrangler
# config holds bindings and ids, never secrets — those go through `wrangler secret put` and never
# touch a file. Ignoring it kept cloudflare/wrangler.toml off the repo, so the Worker could only
# ever be deployed by hand, which is how it went two months without a redeploy.
wrangler.toml
!cloudflare/wrangler.toml
.wrangler/

# Derived board state (see the hexagram board skill) — regenerate with sync.py
.kanban.json
